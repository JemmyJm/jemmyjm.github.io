<script>
(function(){
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* Menu mobile */
  var burger = document.getElementById('burger');
  var menu = document.getElementById('menu');
  burger.addEventListener('click', function(){
    var open = menu.classList.toggle('open');
    burger.setAttribute('aria-expanded', open);
  });
  menu.addEventListener('click', function(e){
    if (e.target.tagName === 'A') { menu.classList.remove('open'); burger.setAttribute('aria-expanded','false'); }
  });

  /* Menu aktif sesuai bagian yang sedang dilihat */
  var links = Array.prototype.slice.call(menu.querySelectorAll('a'));
  var ids = links.map(function(a){ return a.getAttribute('href').slice(1); });
  function setActive(id){
    links.forEach(function(a){ a.classList.toggle('active', a.getAttribute('href') === '#' + id); });
  }
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(en){ if (en.isIntersecting) setActive(en.target.id); });
    }, { rootMargin: '-45% 0px -50% 0px' });
    ids.forEach(function(id){ var el = document.getElementById(id); if (el) io.observe(el); });
  }

  /* Pilihan bahasa contoh (Python / JavaScript) */
  var lang = 'py';
  var switches = document.querySelectorAll('.langswitch button');
  function setLang(l){
    lang = l;
    document.body.setAttribute('data-lang', l);
    switches.forEach(function(b){ b.setAttribute('aria-pressed', b.getAttribute('data-l') === l); });
    renderIf(); renderLoopCode();
  }
  switches.forEach(function(b){ b.addEventListener('click', function(){ setLang(b.getAttribute('data-l')); }); });

  /* Demo If */
  var nilai = document.getElementById('nilai');
  var nilaiOut = document.getElementById('nilaiOut');
  var gradeOut = document.getElementById('gradeOut');
  var gradeWhy = document.getElementById('gradeWhy');
  var traceIf = document.getElementById('traceIf');
  var rules = [[90,'A'],[80,'B'],[70,'C'],[60,'D']];

  function ifLine(i){
    var r = rules[i];
    if (lang === 'py') return (i === 0 ? 'if' : 'elif') + ' nilai >= ' + r[0] + ': grade = "' + r[1] + '"';
    return (i === 0 ? 'if' : 'else if') + ' (nilai >= ' + r[0] + ') grade = "' + r[1] + '";';
  }
  function elseLine(){ return lang === 'py' ? 'else: grade = "E"' : 'else grade = "E";'; }

  function renderIf(){
    var v = parseInt(nilai.value, 10);
    nilaiOut.textContent = v;
    var hit = -1;
    for (var i = 0; i < rules.length; i++) { if (v >= rules[i][0]) { hit = i; break; } }
    var g = hit === -1 ? 'E' : rules[hit][1];
    gradeOut.textContent = g;
    gradeWhy.textContent = hit === -1
      ? 'Tidak ada kondisi yang benar, jadi blok else yang dijalankan.'
      : 'Kondisi nilai >= ' + rules[hit][0] + ' adalah yang pertama benar, jadi grade ' + g + ' dipilih.';
    traceIf.innerHTML = '';
    var total = rules.length + 1;
    for (var j = 0; j < total; j++) {
      var isElse = j === rules.length;
      var status, label;
      if (hit !== -1 && j > hit) { status = 'skip'; label = 'dilewati'; }
      else if ((!isElse && j === hit) || (isElse && hit === -1)) { status = 'yes'; label = 'dipakai'; }
      else { status = 'no'; label = 'salah'; }
      var d = document.createElement('div');
      d.className = 'line ' + status;
      var b = document.createElement('span'); b.className = 'badge'; b.textContent = label;
      var t = document.createElement('span'); t.textContent = isElse ? elseLine() : ifLine(j);
      d.appendChild(b); d.appendChild(t);
      traceIf.appendChild(d);
    }
  }
  nilai.addEventListener('input', renderIf);

  /* Demo Loop */
  var lpType = document.getElementById('lpType');
  var lpMode = document.getElementById('lpMode');
  var lpN = document.getElementById('lpN');
  var lpRun = document.getElementById('lpRun');
  var lpCode = document.getElementById('lpCode');
  var lpOut = document.getElementById('lpOut');
  var lpMsg = document.getElementById('lpMsg');
  var timers = [];

  function getN(){
    var n = parseInt(lpN.value, 10);
    if (isNaN(n) || n < 1 || n > 12) return null;
    return n;
  }
  function renderLoopCode(){
    var n = getN() || 5;
    var t = lpType.value, m = lpMode.value, s = '';
    var body = lang === 'py'
      ? (m === 'cetak' ? 'print(i)' : 'total += i')
      : (m === 'cetak' ? 'console.log(i);' : 'total += i;');
    if (lang === 'py') {
      if (m === 'jumlah') s += 'total = 0\n';
      if (t === 'for') s += 'for i in range(1, ' + (n + 1) + '):\n    ' + body;
      else if (t === 'while') s += 'i = 1\nwhile i <= ' + n + ':\n    ' + body + '\n    i += 1';
      else s += 'i = 1\nwhile True:\n    ' + body + '\n    i += 1\n    if not (i <= ' + n + '):\n        break';
      if (m === 'jumlah') s += '\nprint(total)';
    } else {
      if (m === 'jumlah') s += 'let total = 0;\n';
      if (t === 'for') s += 'for (let i = 1; i <= ' + n + '; i++) {\n  ' + body + '\n}';
      else if (t === 'while') s += 'let i = 1;\nwhile (i <= ' + n + ') {\n  ' + body + '\n  i++;\n}';
      else s += 'let i = 1;\ndo {\n  ' + body + '\n  i++;\n} while (i <= ' + n + ');';
      if (m === 'jumlah') s += '\nconsole.log(total);';
    }
    lpCode.textContent = s;
  }
  function addLine(text, cls){
    var s = document.createElement('span');
    s.className = 'o' + (cls ? ' ' + cls : '');
    s.textContent = text;
    lpOut.appendChild(s);
    lpOut.scrollTop = lpOut.scrollHeight;
  }
  function runLoop(){
    timers.forEach(clearTimeout); timers = [];
    var n = getN();
    if (n === null) { lpMsg.textContent = 'Isi n dengan angka 1 sampai 12.'; return; }
    lpMsg.textContent = '';
    lpOut.innerHTML = '';
    var m = lpMode.value, total = 0, steps = [];
    for (var i = 1; i <= n; i++) {
      if (m === 'cetak') steps.push(['Putaran ' + i + ': ' + i, '']);
      else { var before = total; total += i; steps.push(['Putaran ' + i + ': total = ' + before + ' + ' + i + ' = ' + total, '']); }
    }
    steps.push([m === 'cetak' ? 'Selesai. Loop berhenti karena i menjadi ' + (n + 1) + '.' : 'Selesai. Hasil total = ' + total, 'done']);
    steps.forEach(function(st, idx){
      if (reduce) addLine(st[0], st[1]);
      else timers.push(setTimeout(function(){ addLine(st[0], st[1]); }, idx * 320));
    });
  }
  [lpType, lpMode, lpN].forEach(function(el){ el.addEventListener('input', renderLoopCode); });
  lpRun.addEventListener('click', runLoop);

  /* Sertifikat diperbesar */
  var lb = document.getElementById('lb');
  var lbImg = document.getElementById('lbImg');
  var certSrc = {};
  document.querySelectorAll('.cert').forEach(function(c, i){
    var img = c.querySelector('img');
    certSrc['cert' + (i + 1)] = { src: img.src, alt: img.alt };
  });
  document.querySelectorAll('[data-full]').forEach(function(b){
    b.addEventListener('click', function(){
      var c = certSrc[b.getAttribute('data-full')];
      lbImg.src = c.src; lbImg.alt = c.alt;
      if (typeof lb.showModal === 'function') lb.showModal(); else lb.setAttribute('open','');
    });
  });
  document.getElementById('lbClose').addEventListener('click', function(){ lb.close(); });
  lb.addEventListener('click', function(e){ if (e.target === lb) lb.close(); });

  setLang('py');
})();
</script>
