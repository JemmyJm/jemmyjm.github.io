<style>
:root{
  --paper:#F3F6FB;
  --ink:#14213D;
  --deep:#0D1630;
  --blue:#2B4EFF;
  --sun:#FFC83D;
  --coral:#FF6B57;
  --white:#FFFFFF;
  --muted:#4A5878;
  --line:#D5DDEC;
  --font:'Bricolage Grotesque',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;
  --mono:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{
  margin:0;font-family:var(--font);font-size:1.05rem;line-height:1.65;color:var(--ink);
  background-color:var(--paper);
  background-image:
    linear-gradient(rgba(43,78,255,.06) 1px,transparent 1px),
    linear-gradient(90deg,rgba(43,78,255,.06) 1px,transparent 1px);
  background-size:32px 32px;
}
body[data-lang="py"] .js{display:none !important}
body[data-lang="js"] .py{display:none !important}
img{max-width:100%;display:block}
a{color:inherit}
:focus-visible{outline:3px solid var(--blue);outline-offset:3px;border-radius:6px}
.wrap{width:min(1120px,92%);margin:0 auto}
h1,h2,h3{font-weight:800;line-height:1.05;letter-spacing:-.025em;margin:0}
h2{font-size:clamp(2rem,5vw,3.2rem)}
h3{font-size:1.35rem;letter-spacing:-.015em;line-height:1.2}
p{margin:0}
code,.mono{font-family:var(--mono)}
.inl{font-family:var(--mono);font-size:.88em;background:rgba(43,78,255,.1);color:var(--blue);padding:.08em .4em;border-radius:5px}

/* Navigasi */
.nav{position:sticky;top:0;z-index:50;background:rgba(243,246,251,.88);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-bottom:2px solid var(--ink)}
.nav .wrap{display:flex;align-items:center;justify-content:space-between;height:66px}
.brand{font-weight:800;text-decoration:none;font-size:1.2rem;letter-spacing:-.02em;display:flex;align-items:center;gap:.6rem}
.brand i{display:grid;place-items:center;width:34px;height:34px;background:var(--ink);color:var(--sun);border-radius:9px;font-style:normal;font-size:1.05rem}
.menu{display:flex;gap:.25rem;list-style:none;margin:0;padding:0}
.menu a{display:block;text-decoration:none;font-weight:500;font-size:.98rem;padding:.45rem .85rem;border-radius:999px;transition:background .2s,color .2s}
.menu a:hover{background:rgba(20,33,61,.08)}
.menu a.active{background:var(--ink);color:var(--white)}
.burger{display:none;background:var(--ink);color:var(--white);border:0;border-radius:10px;width:44px;height:44px;cursor:pointer}
.burger svg{width:22px;height:22px}

/* Hero */
.hero{padding:clamp(3rem,8vw,6.5rem) 0 clamp(3.5rem,8vw,6rem)}
.hero .wrap{display:grid;grid-template-columns:1.15fr .85fr;gap:clamp(2rem,5vw,4rem);align-items:center}
.hero h1{font-size:clamp(3.2rem,9.5vw,7rem);line-height:.92;letter-spacing:-.045em}
.hero .lead{margin-top:1.6rem;max-width:34rem;font-size:1.2rem;color:var(--muted)}
.hero .lead b{color:var(--ink)}
.cta{display:flex;flex-wrap:wrap;gap:.9rem;margin-top:2rem}
.btn{display:inline-flex;align-items:center;gap:.6rem;font-family:var(--font);font-weight:700;font-size:1rem;text-decoration:none;padding:.85rem 1.4rem;border-radius:12px;border:2px solid var(--ink);cursor:pointer;transition:transform .15s,box-shadow .15s;background:var(--white);color:var(--ink)}
.btn:hover{transform:translate(-2px,-2px);box-shadow:4px 4px 0 var(--ink)}
.btn:active{transform:translate(0,0);box-shadow:none}
.btn.primary{background:var(--blue);color:var(--white)}
.btn svg{width:20px;height:20px}
.codecard{background:var(--ink);color:#DCE6FF;border-radius:18px;padding:1.4rem 1.5rem 1.6rem;font-family:var(--mono);font-size:.95rem;line-height:1.85;transform:rotate(-2deg);box-shadow:12px 12px 0 var(--sun);position:relative}
.codecard .dots{display:flex;gap:.4rem;margin-bottom:1rem}
.codecard .dots span{width:11px;height:11px;border-radius:50%;background:var(--coral)}
.codecard .dots span:nth-child(2){background:var(--sun)}
.codecard .dots span:nth-child(3){background:#5BD6A0}
.codecard .ln{display:block;white-space:pre-wrap;animation:typein .5s both;animation-delay:calc(var(--i)*.16s + .3s)}
@keyframes typein{from{opacity:0;transform:translateX(-10px)}to{opacity:1;transform:none}}
.k{color:#8FA8FF}.s{color:var(--sun)}.n{color:#7BE0B0}.c{color:#7F8DB5}.f{color:#FF9C8F}

/* Seksi */
.sec{padding:clamp(4rem,9vw,7rem) 0;scroll-margin-top:66px}
.sec.white{background:var(--white);border-top:2px solid var(--ink);border-bottom:2px solid var(--ink);background-image:none}
.sec.navy{background:var(--ink);color:var(--white);background-image:none}
.sechead{display:flex;flex-wrap:wrap;align-items:end;justify-content:space-between;gap:1.2rem;margin-bottom:2.6rem}
.sechead p{max-width:36rem;color:var(--muted);margin-top:.8rem}
.navy .sechead p{color:#B7C4E6}
.langswitch{display:inline-flex;background:var(--paper);border:2px solid var(--ink);border-radius:12px;padding:3px;gap:3px}
.navy .langswitch{background:var(--deep);border-color:#3A4B7A}
.langswitch button{font-family:var(--mono);font-size:.85rem;font-weight:500;border:0;background:transparent;color:inherit;padding:.45rem .9rem;border-radius:9px;cursor:pointer}
.langswitch button[aria-pressed="true"]{background:var(--ink);color:var(--white)}
.navy .langswitch button[aria-pressed="true"]{background:var(--sun);color:var(--ink)}

/* Profil */
.profile{display:grid;grid-template-columns:.9fr 1.1fr;gap:clamp(1.5rem,4vw,3rem);align-items:start}
.idcard{background:var(--paper);border:2px solid var(--ink);border-radius:20px;overflow:hidden;box-shadow:8px 8px 0 var(--ink)}
.idcard .top{display:flex;align-items:center;gap:1rem;padding:1.4rem 1.5rem;background:var(--blue);color:var(--white);border-bottom:2px solid var(--ink)}
.avatar{width:72px;height:72px;border-radius:50%;background:var(--sun);color:var(--ink);display:grid;place-items:center;font-weight:800;font-size:1.9rem;border:2px solid var(--ink);flex:none}
.idcard .top h3{font-size:1.5rem}
.idcard .top span{opacity:.9;font-size:.95rem}
.idcard dl{margin:0;padding:.5rem 1.5rem 1rem}
.idcard .row{display:grid;grid-template-columns:7.5rem 1fr;gap:1rem;padding:.85rem 0;border-bottom:1px dashed var(--line)}
.idcard .row:last-child{border-bottom:0}
.idcard dt{color:var(--muted);font-size:.95rem}
.idcard dd{margin:0;font-weight:700}
.about p+p{margin-top:1rem}
.about .big{font-size:1.35rem;line-height:1.5;font-weight:500}
.chips{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:1.6rem}
.chip{font-weight:700;font-size:.95rem;padding:.4rem .95rem;border-radius:999px;border:2px solid var(--ink);background:var(--white)}
.chip:nth-child(3n+1){background:var(--sun)}
.chip:nth-child(3n+2){background:#CFE0FF}
.chip:nth-child(3n){background:#FFD4CD}
.aboutnote{margin-top:1.8rem;padding-top:1.4rem;border-top:2px solid var(--ink)}
.aboutnote h3{margin-bottom:.5rem}

/* Kode */
.code{margin:0;background:var(--ink);color:#DCE6FF;border-radius:14px;padding:1.1rem 1.25rem;font-family:var(--mono);font-size:.9rem;line-height:1.75;overflow-x:auto;tab-size:4}
.navy .code{background:var(--deep);border:1px solid #2B3C6B}
.code code{font-family:inherit}
.lessons{display:grid;grid-template-columns:repeat(3,1fr);gap:1.4rem}
.lesson{background:var(--paper);border:2px solid var(--ink);border-radius:18px;padding:1.5rem;display:flex;flex-direction:column;gap:1rem}
.lesson h3{display:flex;align-items:center;gap:.6rem}
.lesson .tag{font-family:var(--mono);font-size:.8rem;background:var(--ink);color:var(--sun);padding:.15rem .55rem;border-radius:7px}
.lesson p{color:var(--muted);font-size:1rem}
.lesson .code{font-size:.85rem;margin-top:auto}
.navy .lesson{background:#1B2B52;border-color:#3A4B7A}
.navy .lesson p{color:#B7C4E6}
.navy .lesson .tag{background:var(--sun);color:var(--ink)}

.opgrid{display:grid;grid-template-columns:1fr 1fr;gap:1.4rem;margin-top:1.4rem}
.panel{background:var(--paper);border:2px solid var(--ink);border-radius:18px;padding:1.5rem}
.panel h3{margin-bottom:1rem}
.optable{width:100%;border-collapse:collapse;font-size:.98rem}
.optable td{padding:.55rem 0;border-bottom:1px dashed var(--line)}
.optable tr:last-child td{border-bottom:0}
.optable td:first-child{font-family:var(--mono);font-weight:700;color:var(--blue);width:5.5rem}

/* Demo */
.demo{margin-top:1.4rem;background:var(--ink);color:var(--white);border-radius:22px;padding:clamp(1.3rem,3vw,2.2rem);display:grid;grid-template-columns:1fr 1.1fr;gap:clamp(1.2rem,3vw,2.4rem);box-shadow:10px 10px 0 var(--sun)}
.navy .demo{background:var(--paper);color:var(--ink);box-shadow:10px 10px 0 var(--coral)}
.demo h3{font-size:1.5rem;margin-bottom:.5rem}
.demo .hint{opacity:.8;font-size:.98rem;margin-bottom:1.3rem}
.field{display:flex;flex-direction:column;gap:.45rem;margin-bottom:1.1rem}
.field label{font-weight:700;font-size:.95rem}
.field input[type=number],.field select{font-family:var(--font);font-size:1.05rem;padding:.7rem .9rem;border-radius:11px;border:2px solid currentColor;background:transparent;color:inherit;width:100%}
.field select option{color:var(--ink)}
.field input[type=range]{width:100%;accent-color:var(--sun);height:28px}
.navy .field input[type=range]{accent-color:var(--blue)}
.big-out{display:flex;align-items:center;gap:1rem;margin-top:1.2rem}
.grade{width:76px;height:76px;border-radius:18px;background:var(--sun);color:var(--ink);display:grid;place-items:center;font-size:2.6rem;font-weight:800;flex:none;border:2px solid var(--ink)}
.big-out p{font-size:1rem;line-height:1.45}
.trace{display:flex;flex-direction:column;gap:.5rem}
.trace .line{display:flex;align-items:center;gap:.8rem;font-family:var(--mono);font-size:.88rem;background:#1D2E56;border-radius:11px;padding:.75rem .9rem;border:2px solid transparent;transition:background .2s,opacity .2s,border-color .2s;overflow-x:auto;white-space:nowrap}
.trace .badge{flex:none;font-family:var(--font);font-weight:700;font-size:.75rem;padding:.15rem .5rem;border-radius:6px;background:#2E4275;min-width:4.6rem;text-align:center}
.trace .line.no{opacity:.55}
.trace .line.no .badge{background:#5A2E3C;color:#FFC0B8}
.trace .line.yes{background:#243A70;border-color:var(--sun)}
.trace .line.yes .badge{background:var(--sun);color:var(--ink)}
.trace .line.skip{opacity:.3}
.runrow{display:flex;gap:.8rem;align-items:center;flex-wrap:wrap}
.btn.run{background:var(--blue);color:var(--white)}
.navy .btn.run{box-shadow:none}
.output{background:var(--ink);color:#B8F5D6;border-radius:14px;padding:1rem 1.2rem;font-family:var(--mono);font-size:.9rem;line-height:1.7;min-height:200px;max-height:290px;overflow-y:auto;margin-top:1rem}
.output .o{display:block}
.output .dim{color:#7F8DB5}
.output .done{color:var(--sun)}
.demo .code{font-size:.88rem}
.demo .side{min-width:0}

/* Sertifikat */
.certs{display:grid;grid-template-columns:repeat(2,1fr);gap:1.8rem}
.cert{background:var(--white);border:2px solid var(--ink);border-radius:20px;overflow:hidden;display:flex;flex-direction:column;box-shadow:8px 8px 0 var(--ink);transition:transform .2s,box-shadow .2s}
.cert:hover{transform:translate(-3px,-3px);box-shadow:11px 11px 0 var(--ink)}
.cert button.thumb{display:block;padding:0;border:0;border-bottom:2px solid var(--ink);background:var(--paper);cursor:zoom-in;width:100%}
.cert img{width:100%;height:auto;aspect-ratio:1.4;object-fit:cover}
.cert .body{padding:1.4rem 1.5rem 1.6rem;display:flex;flex-direction:column;gap:.7rem;flex:1}
.role{align-self:flex-start;font-weight:700;font-size:.85rem;padding:.2rem .75rem;border-radius:999px;border:2px solid var(--ink);background:var(--sun)}
.role.b{background:#CFE0FF}
.cert p{color:var(--muted);font-size:1rem}
.cert .meta{font-family:var(--mono);font-size:.82rem;color:var(--ink)}
.cert .btn{align-self:flex-start;margin-top:auto;padding:.6rem 1.1rem;font-size:.95rem}
dialog#lb{border:0;padding:0;background:transparent;max-width:min(1100px,94vw);width:100%}
dialog#lb::backdrop{background:rgba(13,22,48,.85)}
dialog#lb .box{position:relative;background:var(--white);border-radius:16px;padding:.8rem}
dialog#lb img{width:100%;height:auto;border-radius:10px}
dialog#lb .close{position:absolute;top:-14px;right:-8px;background:var(--sun);color:var(--ink);border:2px solid var(--ink);border-radius:999px;font-family:var(--font);font-weight:700;padding:.4rem 1rem;cursor:pointer}

/* Kontak */
.contact{display:grid;grid-template-columns:1fr 1fr;gap:1.4rem}
.ccard{display:flex;align-items:center;gap:1.2rem;text-decoration:none;background:var(--paper);color:var(--ink);border:2px solid var(--ink);border-radius:20px;padding:1.5rem;transition:transform .2s,box-shadow .2s}
.ccard:hover{transform:translate(-3px,-3px);box-shadow:8px 8px 0 var(--sun)}
.ccard .ico{width:64px;height:64px;border-radius:16px;display:grid;place-items:center;flex:none;border:2px solid var(--ink)}
.ccard .ico svg{width:32px;height:32px}
.ccard.wa .ico{background:#5BD6A0}
.ccard.ig .ico{background:var(--coral)}
.ccard small{display:block;color:var(--muted);font-size:.9rem}
.ccard strong{font-size:1.4rem;letter-spacing:-.02em}
footer{padding:1.6rem 0;text-align:center;font-size:.92rem;color:var(--muted);border-top:2px solid var(--ink);background:var(--paper)}

/* Responsif */
@media (max-width:900px){
  .hero .wrap,.profile,.demo,.opgrid,.certs,.contact{grid-template-columns:1fr}
  .lessons{grid-template-columns:1fr}
  .codecard{transform:rotate(-1deg);max-width:520px}
  .burger{display:grid;place-items:center}
  .menu{position:absolute;top:66px;left:0;right:0;flex-direction:column;background:var(--paper);border-bottom:2px solid var(--ink);padding:.6rem 4%;display:none}
  .menu.open{display:flex}
  .menu a{padding:.8rem 1rem;font-size:1.05rem}
}
@media (max-width:480px){
  .idcard .row{grid-template-columns:1fr;gap:.1rem}
  .codecard{font-size:.82rem}
}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{animation:none !important;transition:none !important}
}
</style>
</head>
